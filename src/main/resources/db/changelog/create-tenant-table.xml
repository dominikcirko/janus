<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-tenant-table" author="dominik">
        <createTable tableName="tenant">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_tenant_customer"
                             references="customer(id)"/>
            </column>
            <column name="friendly_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="logo_url" type="varchar(1024)"/>
            <column name="support_email" type="varchar(255)"/>
            <column name="environment_tag" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
        </createTable>

        <createIndex indexName="idx_tenant_customer_id" tableName="tenant">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>