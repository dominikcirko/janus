<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-user-table" author="dominik">
        <createTable tableName="user">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_user_username"/>
            </column>
            <column name="family_name" type="varchar(255)"/>
            <column name="given_name" type="varchar(255)"/>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_user_email"/>
            </column>
            <column name="verified" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_user_tenant"
                             references="tenant(id)"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
        </createTable>

        <createIndex indexName="idx_user_tenant_id" tableName="user">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-add-system-role-field" author="dominik">
        <addColumn tableName="user">
            <column name="system_role" type="varchar(15)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>