<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-client-table" author="dominik">
        <createTable tableName="registered_client">
            <column name="id" type="UUID">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_registered_client"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="client_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="application_name" type="VARCHAR(255)"/>
            <column name="client_id" type="VARCHAR(255)">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_registered_client_client_id"/>
            </column>
            <column name="client_authentication_method" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="client_status" type="VARCHAR(32)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="client_secret_hash" type="VARCHAR(255)"/>
            <column name="client_secret_expires_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="website" type="TEXT"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-redirect-uri-table" author="dominik">
        <createTable tableName="registered_client_redirect_uri">
            <column name="registered_client_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_registered_client_redirect_uri_client"
                             references="registered_client(id)"/>
            </column>
            <column name="redirect_uri" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-grant-type-table" author="dominik">
        <createTable tableName="registered_client_grant_type">
            <column name="registered_client_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_registered_client_grant_type_client"
                             references="registered_client(id)"/>
            </column>
            <column name="grant_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-create-scope-table" author="dominik">
        <createTable tableName="registered_client_scope">
            <column name="registered_client_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_registered_client_scope_client"
                             references="registered_client(id)"/>
            </column>
            <column name="scope" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="005-create-response-type-table" author="dominik">
        <createTable tableName="registered_client_response_type">
            <column name="registered_client_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_registered_client_response_type_client"
                             references="registered_client(id)"/>
            </column>
            <column name="response_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
